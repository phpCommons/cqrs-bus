{
  "name": "php-commons/cqrs-bus",
  "description": "CQRS Bus is a Symfony bundle with Command Bus & Query Bus using Symfony Messenger",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Michał Ligus",
      "email": "maveilthain@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "PhpCommons\\CQRSBus\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.5",
    "symfony/messenger": "^8.0",
    "symfony/http-kernel": "^8.0",
    "symfony/dependency-injection": "^8.0",
    "symfony/yaml": "^8.0",
    "symfony/config": "^8.0",
    "symfony/framework-bundle": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "config": {
    "platform": {
      "php": "8.5.0"
    }
  }
}
